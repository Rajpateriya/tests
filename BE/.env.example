# Project Configuration
PROJECT_NAME="MockExam Platform API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# MongoDB Configuration
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="mock_exam_db"
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=100

# Redis Configuration (For test state caching & palette session persistence)
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED=true
# Fallback to local memory cache if Redis server is unreachable in dev
REDIS_FALLBACK_TO_MEMORY=true

# Security & JWT
JWT_SECRET_KEY="change_this_to_a_very_secure_random_secret_in_production_environment"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# AI Quiz Generation Pipeline
GOOGLE_API_KEY="your_google_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_TAGGING_MODEL="gemini-3.5-flash-lite"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
THEORY_TOP_K=6
THEORY_CANDIDATE_POOL=15
PYQ_STYLE_SAMPLE_SIZE=5
GROUNDEDNESS_THRESHOLD=0.55
DUPLICATE_SIMILARITY_THRESHOLD=0.90
GENERATION_TOPUP_ATTEMPTS=2
GENERATION_BATCH_SIZE=10
LLM_REQUESTS_PER_MINUTE=10
