{
  "info": {
    "_postman_id": "9b12a84c-7c01-4fa2-bf62-11c5cf14e591",
    "name": "Mock Exam & Analytics Platform API",
    "description": "Comprehensive Postman Collection for the Government Exam Mock Test & Analytics Platform (FastAPI + MongoDB). Includes Authentication, Test Discovery, Exam Room Execution (TCS iON flow), Results & Deep Insights, Question Bank Ingestion, and Admin Operations.",
